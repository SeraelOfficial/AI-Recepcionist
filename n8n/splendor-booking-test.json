      "parameters": {
        "jsCode": "const ctx=$('Prepare test agent').first().json;const calls=$json.choices?.[0]?.message?.tool_calls;if(calls?.length!==1||calls[0].function.name!=='create_test_appointment')throw Error('Agent did not select booking tool');const args=JSON.parse(calls[0].function.arguments);for(const k of ['serviceId','providerId','customerId','start','end'])if(args[k]!==ctx.booking[k])throw Error('Agent changed authorized '+k);return [{json:{...args,notes:'PRUEBA IA N8N — serael-booking-agent-20261003 — cita ficticia, no atender ni contactar.'}}];"
      }
