      "name": "Check available slots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://citas.divinosoft.ca/index.php/api/v1/availabilities?providerId='+$json.providerId+'&serviceId='+$json.service.id+'&date='+$json.date }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
