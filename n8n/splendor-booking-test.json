      "name": "Prepare test agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "jsCode": "const slot=$('Choose available slot').first().json;const customer=$json.body;if(!customer.id)throw Error('No synthetic customer id');const booking={...slot,customerId:customer.id};const request={model:'anthropic/claude-sonnet-4.6',temperature:0,max_tokens:500,messages:[{role:'system',content:'Eres un agente de pruebas de integración de reservas. Tu única misión es llamar create_test_appointment con los datos exactos autorizados. Usa solo el servicio de demostración y el cliente ficticio indicados. No envíes mensajes ni hagas reservas de clínica reales. No cambies IDs, fechas ni horas.'},{role:'user',content:'Crea una cita de prueba autorizada con estos datos: '+JSON.stringify(booking)}],tools:[{type:'function',function:{name:'create_test_appointment',description:'Crear una única cita ficticia en EasyAppointments en el horario validado.',parameters:{type:'object',properties:{serviceId:{type:'integer'},providerId:{type:'integer'},customerId:{type:'integer'},start:{type:'string'},end:{type:'string'}},required:['serviceId','providerId','customerId','start','end'],additionalProperties:false}}}],tool_choice:{type:'function',function:{name:'create_test_appointment'}}};return [{json:{booking,request}}];"
      }
    },
