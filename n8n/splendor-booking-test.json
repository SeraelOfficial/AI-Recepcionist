        "jsCode": "const a=$json.body;const expected=$('Validate agent tool call').first().json;for(const k of ['serviceId','providerId','customerId','start','end'])if(a[k]!==expected[k])throw Error('Saved appointment mismatch: '+k);const s=$getWorkflowStaticData('global');s.completed=true;s.appointmentId=a.id;return [{json:{success:true,appointmentId:a.id,start:a.start,end:a.end,timezone:'America/Costa_Rica',service:'Cita de demostracion',customer:'Serael Prueba Agente n8n',credential:'EASY APPOINTMENTS API',agentToolCallVerified:true,demo:true}}];"
