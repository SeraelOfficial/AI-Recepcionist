      "id": "test-7",
      "name": "Prepare candidate dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const service=$('Select demo service').first().json.service;const providers=$json.body;const provider=providers.find(p=>(p.services||[]).map(Number).includes(Number(service.id)));if(!provider)throw Error('No demo provider');if(provider.settings?.notifications!==false)throw Error('Test provider notifications must be off');const out=[];for(let i=2;i<=15;i++){const d=new Date(Date.now()+i*86400000);out.push({json:{date:d.toISOString().slice(0,10),service,providerId:provider.id}})}return out;"
      }
    },
