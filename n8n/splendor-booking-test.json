    {
      "id": "test-9",
      "name": "Choose available slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const candidates=$('Prepare candidate dates').all();const responses=$input.all();for(let i=0;i<responses.length;i++){const slots=responses[i].json.body;if(Array.isArray(slots)&&slots.length){const ctx=candidates[i].json;const start=ctx.date+' '+(String(slots[0]).length===5?slots[0]+':00':slots[0]);const d=new Date(start.replace(' ','T')+'Z');d.setUTCMinutes(d.getUTCMinutes()+Number(ctx.service.duration));return [{json:{serviceId:ctx.service.id,providerId:ctx.providerId,start,end:d.toISOString().slice(0,19).replace('T',' '),testId:'serael-booking-agent-20261003'}}]}}throw Error('No available test slots');"
      }
    },
