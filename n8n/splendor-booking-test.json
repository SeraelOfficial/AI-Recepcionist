        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({firstName:'Serael',lastName:'Prueba Agente n8n',email:'agent-booking-test-20261003@example.invalid',phone:'+50600000000',notes:'CLIENTE FICTICIO: prueba de integración, no contactar.'}) }}",
